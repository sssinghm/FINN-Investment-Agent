# Optional: enables model-written analysis after source retrieval. The app runs without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Set to 1 to disable all outbound data requests and use illustrative records only.
FINN_OFFLINE_MODE=0

# Local app defaults
FINN_HOST=127.0.0.1
FINN_PORT=8000
